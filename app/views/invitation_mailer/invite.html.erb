<div style="background:#faf6f1;padding:32px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#292724;">
  <div style="max-width:520px;margin:0 auto;">
    <p style="text-align:center;font-size:22px;font-weight:800;margin:0 0 4px;">Swipe <span style="color:#d96b35;">&amp;</span> Bite</p>
    <p style="text-align:center;font-size:10px;letter-spacing:2px;color:#89827b;margin:0 0 28px;">GOOD FOOD. BETTER TOGETHER.</p>

    <div style="background:#ffffff;border:1px solid #eee9e3;border-radius:16px;padding:28px;">
      <p style="color:#d96b35;font-size:11px;font-weight:700;letter-spacing:1.5px;margin:0 0 8px;">YOU'RE INVITED</p>
      <h1 style="font-size:24px;font-weight:800;margin:0 0 12px;"><%= @nomikai.name %></h1>
      <p style="color:#77716b;font-size:14px;line-height:1.5;margin:0 0 20px;">
        <%= @host_name %> wants your input to pick the perfect restaurant. Share your preferences and swipe on a few vibes. It only takes a minute.
      </p>

      <table role="presentation" style="width:100%;font-size:13px;color:#69635d;margin-bottom:24px;">
        <tr><td style="padding:4px 0;">📍 <%= @nomikai.area %></td></tr>
        <tr><td style="padding:4px 0;">📅 <%= @nomikai.meal_period.capitalize %></td></tr>
        <tr><td style="padding:4px 0;">👥 <%= @nomikai.group_size %> people</td></tr>
      </table>

      <p style="text-align:center;margin:0 0 24px;">
        <%= link_to "Join the event", invite_url(@invitation.token),
                    style: "display:inline-block;background:#d96b35;color:#ffffff;text-decoration:none;font-weight:700;padding:14px 28px;border-radius:9px;" %>
      </p>

      <div style="background:#faf6f1;border-radius:12px;padding:16px;text-align:center;">
        <p style="color:#89827b;font-size:11px;font-weight:700;letter-spacing:1px;margin:0 0 6px;">OR JOIN WITH THIS CODE</p>
        <p style="font-family:'SFMono-Regular',Menlo,Consolas,monospace;font-size:22px;font-weight:700;letter-spacing:2px;margin:0 0 6px;"><%= @nomikai.formatted_join_code %></p>
        <p style="color:#77716b;font-size:12px;margin:0;">Enter it at <%= link_to join_code_url, join_code_url, style: "color:#d96b35;" %></p>
      </div>
    </div>

    <p style="text-align:center;color:#aaa29a;font-size:12px;margin-top:20px;">
      You received this because <%= @host_name %> invited <%= @invitation.email %>.
    </p>
  </div>
</div>
