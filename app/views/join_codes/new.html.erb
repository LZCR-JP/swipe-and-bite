<div class="container py-5">
  <div class="participant-join quick-join">
    <div class="join-header">
      <h1>Join a gathering</h1>
      <p>Enter the 4-digit code from your host.</p>
    </div>

    <div class="join-form-card join-code-card">
      <%= form_with url: join_code_path, method: :post do |f| %>
        <% error = @error || flash[:alert] %>
        <%= f.label :code, "Join code", class: "visually-hidden" %>
        <%= f.text_field :code,
                         value: @code,
                         placeholder: "0000",
                         inputmode: "numeric",
                         pattern: "[0-9]{4}",
                         maxlength: 4,
                         autocomplete: "off",
                         required: true,
                         class: ["form-control", "join-code-input", ("is-invalid" if error)].compact.join(" "),
                         aria: { invalid: error.present?, describedby: ("join_code_error" if error) } %>
        <% if error.present? %>
          <p id="join_code_error" class="join-code-error" role="alert"><%= error %></p>
        <% end %>
        <%= f.submit "Continue", class: "btn-join-event" %>
      <% end %>
    </div>
  </div>
</div>
