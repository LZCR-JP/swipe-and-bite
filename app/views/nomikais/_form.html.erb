<div class="meeting-create" data-controller="meeting-map" data-meeting-map-key-value="<%= ENV.fetch('GOOGLE_MAPS_BROWSER_KEY', '') %>">
  <%= form_with model: @nomikai, class: "meeting-create__form", data: { action: "submit->meeting-map#submit" } do |f| %>
    <% if @nomikai.errors.any? %>
      <div class="meeting-create__errors" role="alert"><%= @nomikai.errors.full_messages.join(" · ") %></div>
    <% end %>
    <div class="meeting-create__map-wrap">
      <div class="meeting-create__map" data-meeting-map-target="map"></div>
      <div class="meeting-create__pin" data-meeting-map-target="pin" hidden><i class="fa-solid fa-location-dot"></i></div>
      <div class="meeting-create__search">
        <%= f.text_field :area, placeholder: "Search meeting location", aria: { label: "Meeting location" }, required: true, data: { meeting_map_target: "area", action: "input->meeting-map#areaEdited keydown.enter->meeting-map#search" } %>
        <button type="button" data-action="meeting-map#search" aria-label="Search location"><i class="fa-solid fa-magnifying-glass"></i></button>
      </div>
      <div class="meeting-create__map-note" data-meeting-map-target="status" aria-live="polite">Loading map…</div>
      <%= f.hidden_field :latitude, data: { meeting_map_target: "latitude" } %>
      <%= f.hidden_field :longitude, data: { meeting_map_target: "longitude" } %>
    </div>
    <section class="meeting-create__sheet">
      <div class="meeting-create__handle"></div>
      <h1><%= @nomikai.persisted? ? "Edit gathering" : "Let's eat." %></h1>
      <div class="meeting-create__location" role="status" aria-live="polite">
        <span class="meeting-create__location-icon"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
        <div class="meeting-create__location-text">
          <small>Meeting point</small>
          <strong data-meeting-map-target="locationName"><%= @nomikai.area == "Selected on map" ? "Pinned location" : (@nomikai.area.presence || "Choose a meeting point") %></strong>
        </div>
        <button type="button" data-action="meeting-map#locate" aria-label="Use current location"><i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i></button>
      </div>
      <div class="meeting-create__meal" role="group" aria-label="Meal">
        <% %w[lunch dinner].each do |meal| %>
          <label>
            <%= f.radio_button :meal_period, meal, required: true %>
            <span><i class="fa-solid <%= meal == 'lunch' ? 'fa-sun' : 'fa-moon' %>"></i> <%= meal.capitalize %></span>
          </label>
        <% end %>
      </div>
      <div class="meeting-create__line">
        <div><strong>People</strong><small>Including you</small></div>
        <div class="meeting-create__stepper">
          <button type="button" aria-label="Fewer people" data-action="meeting-map#decrease">−</button>
          <%= f.number_field :group_size, min: 2, max: 50, value: @nomikai.group_size || 4, required: true, aria: { label: "People" }, data: { meeting_map_target: "people" } %>
          <button type="button" aria-label="More people" data-action="meeting-map#increase">+</button>
        </div>
      </div>
      <div class="meeting-create__line">
        <div><strong>Budget per person</strong><small>JPY</small></div>
        <div class="meeting-create__budget">¥ <%= f.number_field :budget_per_person, min: 500, step: 1, placeholder: "Enter amount", required: true, aria: { label: "Budget per person in yen" }, inputmode: "numeric", data: { controller: "budget-input", action: "input->budget-input#format turbo:before-cache@document->budget-input#restore" } %></div>
      </div>
      <%= f.submit(@nomikai.persisted? ? "Save changes" : "Create gathering", class: "meeting-create__submit") %>
    </section>
  <% end %>
</div>
