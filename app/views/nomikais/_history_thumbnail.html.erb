<span class="<%= icon_class %><%= ' history-photo-thumb' if history_photo_available?(plan) %>">
  <i class="fa-solid <%= fallback_icon %>" aria-hidden="true"<% if history_photo_available?(plan) %> data-history-photo-target="fallback"<% end %>></i>
