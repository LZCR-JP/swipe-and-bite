<% active_tab = params[:tab] == "email" ? "email" : "code" %>

<div id="invite" class="show-section invite-section" data-controller="tabs" data-tabs-active-value="<%= active_tab %>">
  <h2>Invite your team</h2>
  <p>Share a join code, or send invites straight to your teammates' inboxes.</p>

  <% if flash[:invite_notice].present? %>
    <div class="invite-flash success"><%= flash[:invite_notice] %></div>
  <% end %>
  <% if flash[:invite_alert].present? %>
    <div class="invite-flash warning"><%= flash[:invite_alert] %></div>
  <% end %>

  <% if nomikai.accepting_participants? %>
    <div class="invite-tabs" role="tablist">
      <button type="button" role="tab" class="invite-tab" data-tabs-target="tab" data-tab="code" data-action="tabs#select">
        <i class="fa-solid fa-hashtag"></i> Join code
      </button>
      <button type="button" role="tab" class="invite-tab" data-tabs-target="tab" data-tab="email" data-action="tabs#select">
        <i class="fa-solid fa-envelope"></i> Email invite
      </button>
    </div>

    <!-- Join code -->
    <div class="invite-panel" role="tabpanel" data-tabs-target="panel" data-tab="code">
      <div class="join-code-box" data-controller="clipboard" data-clipboard-text-value="<%= nomikai.formatted_join_code %>">
        <span class="join-code-label">TEAM JOIN CODE</span>
        <div class="join-code-row">
          <code class="join-code"><%= nomikai.formatted_join_code %></code>
          <button type="button" class="btn-copy" data-action="clipboard#copy">
            Copy code
          </button>
        </div>
        <small class="copy-message" data-clipboard-target="message"></small>
      </div>

      <ol class="invite-steps">
        <li>Ask teammates to open <strong><%= join_code_url %></strong></li>
        <li>They enter <strong><%= nomikai.formatted_join_code %></strong></li>
        <li>They share their preferences and start swiping</li>
      </ol>

      <div class="invite-code-footer">
        <span>Works while the gathering is open and accepting participants.</span>
        <%= button_to "Regenerate code",
                      regenerate_code_nomikai_path(nomikai),
                      method: :patch,
                      class: "btn-text-link",
                      form: { data: { turbo_confirm: "Create a new code? The current code will stop working right away." } } %>
      </div>

      <details class="invite-link-fallback">
        <summary>Or share a direct link</summary>
        <div data-controller="clipboard" class="invite-link">
          <input type="text" class="form-control" value="<%= join_url(nomikai.share_token) %>" readonly data-clipboard-target="source">
          <button type="button" class="btn-copy" data-action="click->clipboard#copy">Copy link</button>
          <small data-clipboard-target="message"></small>
        </div>
      </details>
    </div>

    <!-- Email invite -->
    <div class="invite-panel" role="tabpanel" data-tabs-target="panel" data-tab="email" hidden>
      <%= simple_form_for :invitation,
                          url: nomikai_invitations_path(nomikai),
                          method: :post,
                          html: { class: "invite-email-form" } do |f| %>
        <%= f.input :emails,
                    as: :text,
                    label: "Teammate emails",
                    required: true,
                    placeholder: "aiko@company.com, ken@company.com",
                    input_html: { id: "invite_emails", rows: 3, class: "form-control" } %>

        <div class="invite-form-footer">
          <small>Separate emails with commas or new lines (up to <%= InvitationSender::MAX_PER_REQUEST %> at a time).</small>
          <%= f.button :submit, "Send invites", class: "btn-copy" %>
        </div>
      <% end %>

      <% if invitations.any? %>
        <div class="invite-list">
          <span class="invite-list-label">INVITED</span>
          <% invitations.each do |invitation| %>
            <div class="participant-row invite-row">
              <div class="participant-avatar"><%= invitation.email.first.upcase %></div>

              <div class="invite-row-info">
                <strong><%= invitation.email %></strong>
                <small>
                  <% if invitation.accepted? %>
                    Joined <%= time_ago_in_words(invitation.accepted_at) %> ago
                  <% elsif invitation.sent_at %>
                    Sent <%= time_ago_in_words(invitation.sent_at) %> ago
                  <% end %>
                </small>
              </div>

              <% if invitation.accepted? %>
                <span class="participant-status completed">Joined</span>
              <% else %>
                <span class="participant-status pending">Pending</span>
                <div class="invite-row-actions">
                  <%= button_to "Resend", resend_nomikai_invitation_path(nomikai, invitation),
                                class: "btn-text-link", disabled: invitation.recently_sent? %>
                  <%= button_to "Revoke", nomikai_invitation_path(nomikai, invitation),
                                method: :delete,
                                class: "btn-text-link danger",
                                form: { data: { turbo_confirm: "Revoke the invite to #{invitation.email}? Their link will stop working." } } %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="invite-closed">
      <i class="fa-solid fa-lock"></i>
      This event is no longer accepting new teammates, so the join code and invites are turned off.
    </div>
  <% end %>
</div>
