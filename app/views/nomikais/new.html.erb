<div class="container mt-4">
  <h1>Create a Nomikai</h1>

  <%= simple_form_for @nomikai do |f| %>
    <%= f.input :name, label: "Nomikai name", required: true %>

    <%= f.input :area, label: "Location", placeholder: "e.g. Shibuya", required: true %>

    <%= f.input :event_date, as: :datetime, html5: true, label: "Date & time", required: true %>

    <%= f.input :group_size, label: "Number of people", input_html: { min: 1 }, required: true %>

    <%= f.input :budget_per_person, label: "Budget per person (JPY)", input_html: { min: 1 }, required: true %>

    <%= f.button :submit, "Create Nomikai", class: "btn btn-primary" %>
  <% end %>

  <%= link_to "Back", nomikais_path, class: "btn btn-outline-secondary mt-3" %>
</div>