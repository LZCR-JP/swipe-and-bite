<div class="recommendations-screen">
  <main class="recommendations-page">
    <header class="recommendations-topbar">
      <%= link_to nomikai_path(@nomikai), class: "recommendations-back-link", aria: { label: "Back to plan" } do %>
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
      <% end %>
      <span>Restaurants</span>
      <span class="recommendations-topbar__spacer" aria-hidden="true"></span>
    </header>
    <header class="recommendations-header">
      <h1>Top picks <span class="sb-emoji" aria-hidden="true">✨</span></h1>
      <p>Choose a restaurant for your plan.</p>
    </header>

    <% if @used_fallback && @places.any? %>
      <p class="recommendations-fallback">Showing a broader search.</p>
    <% end %>

    <% if @places.any? %>
      <% allow_vote = @nomikai.decision_state != "voting" && @nomikai.voting_participants.exists? %>
      <div class="recommendation-list">
        <% @places.each do |place| %>
          <article class="recommendation-card">
            <figure class="recommendation-photo" data-controller="restaurant-preview">
              <div class="recommendation-photo__image">
                <div class="recommendation-no-photo" data-restaurant-preview-target="fallback">
                  <i class="fa-solid fa-utensils" aria-hidden="true"></i>
                  <span data-restaurant-preview-target="message"><%= place[:photo_name].present? ? "Loading photo…" : "Photo unavailable" %></span>
                </div>
                <% if place[:photo_name].present? %>
                  <% token = Rails.application.message_verifier(:restaurant_photo).generate(place[:photo_name], expires_in: 15.minutes, purpose: :restaurant_photo) %>
                  <%= image_tag restaurant_photo_path(token: token), alt: "Photo of #{place[:name]}", loading: "lazy", decoding: "async", data: { restaurant_preview_target: "image", action: "load->restaurant-preview#loaded error->restaurant-preview#failed" } %>
                <% end %>
              </div>
              <% if place[:photo_name].present? && place[:photo_attributions].present? %>
                <figcaption data-restaurant-preview-target="credit">
                  <% place[:photo_attributions].each do |author| %>
                    <% if author["displayName"].present? %>
                      <% if author["uri"].present? %>
                        <%= link_to author["displayName"], author["uri"], target: "_blank", rel: "noopener noreferrer" %>
                      <% else %>
                        <%= author["displayName"] %>
                      <% end %>
                    <% end %>
                  <% end %>
                </figcaption>
              <% end %>
            </figure>

            <div class="recommendation-details">
              <h2><%= place[:name].presence || "Restaurant" %></h2>
              <% price = restaurant_price_range(place[:price_range]) %>
              <% low = place[:price_range].is_a?(Hash) ? place[:price_range]["startPrice"] : nil %>
              <% above_budget = price.present? && low.is_a?(Hash) && low["currencyCode"] == "JPY" && low["units"].to_i > @nomikai.budget_per_person.to_i && @nomikai.budget_per_person.present? %>
              <div class="recommendation-price-row">
                <p class="recommendation-price"><%= price || "Price unavailable" %><% if price.present? %> <small>/ person · estimate</small><% end %></p>
                <% if above_budget %><span class="recommendation-budget-note">Above budget</span><% end %>
              </div>
              <% if place[:address].present? %>
                <p class="recommendation-address"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span><%= place[:address] %></span></p>
              <% end %>

              <details class="recommendation-why">
                <summary>
                  <span><span class="sb-emoji" aria-hidden="true">💡</span> Why we picked it</span>
                  <i class="fa-solid fa-chevron-down recommendation-why__chevron" aria-hidden="true"></i>
                </summary>
                <div class="recommendation-why__content">
                  <% search_area = @nomikai.area == "Selected on map" ? "your chosen meeting point" : @nomikai.area.presence || "your chosen area" %>
                  <p><%= @used_fallback ? "Found through a broader search" : "Found through your group's restaurant search" %> near <%= search_area %>.</p>
                  <% cuisine = place[:category].presence || place[:cuisine].to_s.humanize.presence %>
                  <% if cuisine.present? %>
                    <p><strong>Cuisine:</strong> <%= cuisine %></p>
                  <% end %>
                  <% high = place[:price_range].is_a?(Hash) ? place[:price_range]["endPrice"] : nil %>
                  <% if @nomikai.budget_per_person.present? && price.present? %>
                    <% if above_budget %>
                      <p><strong>Budget:</strong> Above your budget.</p>
                    <% elsif high.is_a?(Hash) && high["currencyCode"] == "JPY" && high["units"].to_i <= @nomikai.budget_per_person %>
                      <p><strong>Budget:</strong> Within your budget (Google estimate).</p>
                    <% elsif low.is_a?(Hash) && high.is_a?(Hash) && low["currencyCode"] == "JPY" && high["currencyCode"] == "JPY" %>
                      <p><strong>Budget:</strong> The estimated price range overlaps your budget.</p>
                    <% else %>
                      <p><strong>Budget:</strong> Check the final price with the restaurant.</p>
                    <% end %>
                  <% else %>
                    <p><strong>Budget:</strong> Price fit could not be verified.</p>
                  <% end %>
                  <p class="recommendation-why__note">Confirm prices, seating and dietary needs with the restaurant.</p>
                </div>
              </details>

              <% if place[:google_maps_uri].present? || place[:website].present? %>
                <div class="recommendation-actions">
                  <% if place[:google_maps_uri].present? %>
                    <%= link_to place[:google_maps_uri], class: "recommendation-map-link", target: "_blank", rel: "noopener noreferrer" do %>
                      <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i> Maps
                    <% end %>
                  <% end %>
                  <% if place[:website].present? %>
                    <%= link_to place[:website], class: "recommendation-map-link", target: "_blank", rel: "noopener noreferrer" do %>
                      Website <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
              <%= render "restaurant_decision_sheet", candidate_id: place[:candidate_id], restaurant_name: place[:name],
                  button_label: "Select restaurant", button_class: "recommendation-select-button", allow_vote: allow_vote %>

              <% Array(place[:attributions]).each do |attribution| %>
                <% if attribution["provider"].present? %>
                  <p class="recommendations-attribution recommendation-provider-credit">
                    <% if attribution["providerUri"].present? %>
                      <%= link_to attribution["provider"], attribution["providerUri"], target: "_blank", rel: "noopener noreferrer" %>
                    <% else %>
                      <%= attribution["provider"] %>
                    <% end %>
                  </p>
                <% end %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
      <p class="recommendations-attribution" translate="no">Google Maps</p>
      <p class="recommendations-note">Confirm prices, seating and dietary needs with the restaurant.</p>
    <% else %>
      <section class="recommendations-empty">
        <h2><%= @reshuffled ? "No more matches on this search" : "We couldn’t find a match yet" %></h2>
        <p>
          <% if @nomikai.collecting_swipes? %>
            Try a nearby area or adjust the budget, then search again.
          <% else %>
            Go back to your plan to start a fresh search.
          <% end %>
        </p>
        <% if @nomikai.collecting_swipes? %>
          <%= link_to "Adjust area or budget", edit_nomikai_path(@nomikai), class: "recommendations-empty__action" %>
        <% else %>
          <%= link_to "Back to plan", nomikai_path(@nomikai), class: "recommendations-empty__action" %>
        <% end %>
      </section>
    <% end %>

    <footer class="recommendations-footer">
      <% if @next_matches_token.present? %>
        <%= button_to "↻  Find other restaurants", recommendations_nomikai_path(@nomikai),
                      method: :post,
                      params: { continuation: @next_matches_token },
                      class: "recommendations-reshuffle-button",
                      form: { class: "recommendations-reshuffle-form", data: { controller: "match-loading", action: "submit->match-loading#start turbo:submit-end->match-loading#reset pageshow@window->match-loading#reset turbo:before-cache@document->match-loading#reset" } } %>
      <% elsif @places.any? %>
        <p>No more matches for this search.</p>
      <% end %>
    </footer>
  </main>
</div>
