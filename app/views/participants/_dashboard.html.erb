<% venue = @selected_candidate&.venue %>
<% details = @restaurant_details || {} %>
<% restaurant_name = details[:name].presence || venue&.name.presence || "Restaurant selected" %>
<% address = details[:formatted_address].presence || venue&.formatted_address %>
<% maps_url = details[:google_maps_uri].presence || venue&.google_maps_uri.presence || (venue && "https://www.google.com/maps/search/?api=1&query=restaurant&query_place_id=#{ERB::Util.url_encode(venue.google_place_id)}") %>
<% budget = @participant.budget_max || @nomikai.budget_per_person %>
<% price_label = restaurant_price_range(details[:price_range]) %>
<% voting = @nomikai.restaurant_feedback_open? %>
<% voted = voting && @candidate_vote.present? %>

<main class="participant-page participant-page--focused" <% if @nomikai.ongoing? %>data-controller="decision-refresh" data-decision-refresh-url-value="<%= participant_path(@participant.token, format: :json) %>" data-decision-refresh-signature-value="<%= @nomikai.decision_signature %>"<% end %>>
  <div class="participant-dashboard">
    <header class="participant-focus-header">
      <%= link_to nomikais_path, class: "participant-focus-header__icon", aria: { label: "Back to plans" } do %>
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
      <% end %>
      <span><%= @nomikai.confirmed? ? "Confirmed" : @selected_candidate.present? ? "Restaurant" : "Your plan" %></span>
      <%= link_to participant_path(@participant.token), class: "participant-focus-header__icon", aria: { label: "Refresh status" }, data: { turbo: false } do %>
        <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
      <% end %>
    </header>

    <% if @selected_candidate.present? %>
      <div class="participant-focus-heading" aria-live="polite">
        <% if @nomikai.confirmed? %>
          <span class="participant-focus-heading__status"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Confirmed</span>
          <h1>It's confirmed!</h1>
          <p>See you there.</p>
        <% elsif voted %>
          <h1>Vote submitted</h1>
          <p><%= @nomikai.all_votes_received? ? "Waiting for host confirmation" : "Waiting for the remaining votes" %></p>
        <% else %>
          <h1>Host picked a restaurant</h1>
          <p>Take a look and cast your vote.</p>
        <% end %>
      </div>

      <section class="participant-restaurant" aria-labelledby="participant-pick-title">
        <%= render "restaurant_photo", details: details, restaurant_name: restaurant_name %>
        <div class="participant-restaurant__body">
          <h2 id="participant-pick-title"><%= restaurant_name %></h2>
          <p class="participant-restaurant__price"><%= price_label || "Price unavailable" %><% if price_label %> <span>/ person · estimate</span><% end %></p>
          <% if address.present? %>
            <p class="participant-restaurant__address"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span><%= address %></span></p>
          <% end %>
          <% if maps_url.present? %>
            <%= link_to maps_url, class: "participant-restaurant__maps", target: "_blank", rel: "noopener noreferrer" do %>
              <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i> Open in Maps <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
            <% end %>
          <% end %>
          <% Array(details[:attributions]).each do |attribution| %>
            <% if attribution["provider"].present? %>
              <p class="participant-restaurant__credit"><% if attribution["providerUri"].present? %><%= link_to attribution["provider"], attribution["providerUri"], target: "_blank", rel: "noopener noreferrer" %><% else %><%= attribution["provider"] %><% end %></p>
            <% end %>
          <% end %>
          <p class="participant-restaurant__credit" translate="no">Google Maps</p>
        </div>
      </section>

      <% if voting %>
        <section class="participant-decision" aria-label="Your vote">
          <% if voted %>
            <div class="participant-decision__saved" role="status"><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span>Your vote: <strong><%= @candidate_vote.approved? ? "I'm in" : "Another option" %></strong></span></div>
            <% eligible_count = @nomikai.voting_participants.count %>
            <% votes_count = @selected_candidate.candidate_votes.where(participant_id: @nomikai.voting_participants.select(:id)).count %>
            <div class="participant-decision__progress"><span>Votes submitted</span><strong><%= votes_count %> / <%= eligible_count %></strong></div>
            <progress max="<%= [eligible_count, 1].max %>" value="<%= votes_count %>" aria-label="Votes submitted"></progress>
          <% else %>
            <h2>Does this work for you?</h2>
            <div class="participant-vote-actions">
              <%= button_to participant_candidate_votes_path(@participant.token), method: :post, params: { candidate_id: @selected_candidate.id, approved: true, decision_round: @nomikai.decision_round }, class: "participant-vote-button participant-vote-button--approve" do %>
                <i class="fa-solid fa-check" aria-hidden="true"></i> I'm in
              <% end %>
              <%= button_to participant_candidate_votes_path(@participant.token), method: :post, params: { candidate_id: @selected_candidate.id, approved: false, decision_round: @nomikai.decision_round }, class: "participant-vote-button participant-vote-button--alternative" do %>
                Another option
              <% end %>
            </div>
          <% end %>
          <p class="participant-decision__note">Your host makes the final decision.</p>
        </section>
      <% end %>
    <% else %>
      <section class="participant-pick-card participant-pick-card--waiting" aria-labelledby="participant-pick-title">
        <% if @nomikai.ongoing? && (@nomikai.matches_ready? || @participant.completed_at.present?) %>
          <div class="plan-wait-art" aria-hidden="true"><span><i class="fa-solid fa-utensils"></i></span><span><i class="fa-solid fa-heart"></i></span><span><i class="fa-solid fa-location-dot"></i></span></div>
          <div class="plan-wait-indicator"><i></i><i></i><i></i><span>In progress</span></div>
        <% end %>
        <% if @nomikai.ongoing? && @nomikai.matches_ready? %>
          <h2 id="participant-pick-title"><%= @nomikai.decision_state == "rejected" ? "Finding another spot" : "Waiting for the host" %></h2>
          <p><%= @nomikai.decision_state == "rejected" ? "The host is choosing another restaurant." : "The host is reviewing the matches." %></p>
        <% elsif @nomikai.ongoing? && @participant.completed_at.present? %>
          <h2 id="participant-pick-title">Swipes complete</h2>
          <p>Your preferences are saved. Waiting for the host to find restaurants.</p>
        <% elsif @nomikai.ongoing? %>
          <h2 id="participant-pick-title">Time to swipe.</h2>
          <p>Swipe to show what you like.</p>
          <%= link_to participant_swipes_path(@participant.token), class: "participant-primary-link" do %>
            Continue swiping <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          <% end %>
        <% else %>
          <h2 id="participant-pick-title">This plan has ended.</h2>
          <p>Your organizer can share any final plans with you directly.</p>
        <% end %>
      </section>
      <% if @participant.completed_at.present? && @nomikai.ongoing? %>
        <details class="participant-preferences">
          <summary>
            <span><i class="fa-solid fa-sliders" aria-hidden="true"></i> Your saved preferences</span>
            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
          </summary>
          <dl>
            <div><dt>Budget per person</dt><dd><%= budget.present? ? "¥#{number_with_delimiter(budget)}" : "Flexible" %></dd></div>
            <div><dt>Dietary needs</dt><dd><%= @participant.restrictions.present? ? @participant.restrictions.join(", ") : "None shared" %></dd></div>
            <div><dt>Alcohol</dt><dd><%= @participant.non_drinker ? "No alcohol" : "No preference" %></dd></div>
            <% if @liked_vibes.any? || @passed_vibes.any? %>
              <div class="participant-preferences__swipe-row"><dt>Liked (<%= @liked_vibes.size %>)</dt><dd><%= @liked_vibes.any? ? @liked_vibes.join(", ") : "None" %></dd></div>
              <div class="participant-preferences__swipe-row"><dt>Passed on (<%= @passed_vibes.size %>)</dt><dd><%= @passed_vibes.any? ? @passed_vibes.join(", ") : "None" %></dd></div>
            <% else %>
              <div class="participant-preferences__swipe-row"><dt>Swipe results</dt><dd>No cards swiped yet</dd></div>
            <% end %>
          </dl>
        </details>
      <% end %>
    <% end %>
  </div>
</main>
