
<div class="container py-5">
  <div class="participant-dashboard">

    <!-- Welcome header -->
    <div class="participant-welcome">
      <span class="welcome-label">SWIPE & BITE</span>
      <h1>You're in, <%= @participant.nickname.capitalize %>!</h1>
      <p>Let's find somewhere delicious.</p>
    </div>

    <!-- Event card -->
    <div class="participant-event-card">
      <div class="event-card-header">
        <div>
          <span class="section-label">YOUR EVENT</span>
          <h2><%= @nomikai.name.capitalize %></h2>
        </div>

        <span class="event-status <%= @nomikai.restaurant_feedback_open? ? 'open' : @nomikai.status %>">
          <%= @nomikai.restaurant_feedback_open? ? "Feedback open" : @nomikai.status.capitalize %>
        </span>
      </div>

      <div class="event-info-grid">
        <div class="event-info-item">
          <i class="fa-solid fa-location-dot"></i>
          <div>
            <span>Location</span>
            <strong><%= @nomikai.area %></strong>
          </div>
        </div>

        <div class="event-info-item">
          <i class="fa-solid fa-calendar"></i>
          <div>
            <span>Meal</span>
            <strong><%= @nomikai.meal_period.capitalize %></strong>
          </div>
        </div>
      </div>
    </div>

    <% if @selected_candidate.present? %>
      <% place_id = @selected_candidate.venue.google_place_id %>
      <% maps_url = "https://www.google.com/maps/search/?api=1&query=restaurant&query_place_id=#{ERB::Util.url_encode(place_id)}" %>

      <section class="participant-event-card participant-selected-restaurant">
        <div class="selected-restaurant-heading">
          <div>
            <span class="section-label">RESTAURANT CHOSEN</span>
            <h2>Your group’s restaurant is ready</h2>
            <p>The organizer selected a place for this event.</p>
          </div>

          <span class="selected-restaurant-badge">Selected</span>
        </div>

        <%= link_to "Open in Google Maps",
                    maps_url,
                    class: "btn-open-selected-restaurant",
                    target: "_blank",
                    rel: "noopener noreferrer" %>

        <% if @nomikai.restaurant_feedback_open? %>
          <p class="vote-prompt">Would this place work for your group? Your feedback helps the host decide whether to keep it.</p>

          <% if @candidate_vote.present? %>
            <p class="vote-status">
              Your response:
              <strong><%= @candidate_vote.approved? ? "Looks good" : "I’d like another option" %></strong>
            </p>
          <% end %>

          <div class="participant-vote-actions">
            <%= button_to "Looks good",
                          participant_candidate_votes_path(@participant.token),
                          method: :post,
                          params: {
                            candidate_id: @selected_candidate.id,
                            approved: true
                          },
                          class: "btn-vote-approve" %>

            <%= button_to "I’d like another option",
                          participant_candidate_votes_path(@participant.token),
                          method: :post,
                          params: {
                            candidate_id: @selected_candidate.id,
                            approved: false
                          },
                          class: "btn-vote-another" %>
          </div>
        <% else %>
          <p class="vote-prompt">Voting is closed for this event.</p>
        <% end %>
      </section>
    <% else %>
      <section class="participant-event-card participant-selected-restaurant">
        <span class="section-label">RESTAURANT MATCH</span>
        <% if @nomikai.finished? %>
          <p>Your host has found restaurant matches.</p>
        <% elsif @nomikai.ongoing? %>
          <p>Waiting for your host to find restaurant matches.</p>
        <% else %>
          <p>Your host cancelled this gathering.</p>
        <% end %>
      </section>
    <% end %>

    <!-- Personal preferences -->
    <div class="participant-preferences">
      <div class="preferences-heading">
        <h2>Your dining preferences</h2>
      </div>

      <div class="preference-row">
        <div class="preference-icon">
          <i class="fa-solid fa-wallet"></i>
        </div>
        <div class="preference-content">
          <span>Budget per person</span>
          <% budget = @participant.budget_max || @nomikai.budget_per_person %>
          <strong><%= budget.present? ? "¥#{number_with_delimiter(budget)}" : "Flexible" %></strong>
        </div>
      </div>

      <div class="preference-row">
        <div class="preference-icon">
          <i class="fa-solid fa-utensils"></i>
        </div>
        <div class="preference-content">
          <span>Dietary restrictions</span>
          <strong>
            <%= @participant.restrictions.present? ? @participant.restrictions.join(", ") : "None" %>
          </strong>
        </div>
      </div>

      <div class="preference-row">
        <div class="preference-icon">
          <i class="fa-solid fa-wine-glass"></i>
        </div>
        <div class="preference-content">
          <span>Alcohol preference</span>
          <strong><%= @participant.non_drinker ? "Non-drinker" : "No preference" %></strong>
        </div>
      </div>
    </div>

    <!-- Next step -->
    <div class="participant-next-step">
      <% if @nomikai.ongoing? && @participant.completed_at.present? %>
        <div><h2>You're all set.</h2><p>Waiting for your host to find matches.</p></div>
      <% elsif @nomikai.ongoing? %>
        <div>
          <h2>Ready to find your next favorite spot?</h2>
          <p>Swipe through dining styles to help your team find a restaurant everyone will enjoy.</p>
        </div>

        <%= link_to participant_swipes_path(@participant.token),
                    class: "btn-start-swiping" do %>
          Start Swiping
          <i class="fa-solid fa-arrow-right"></i>
        <% end %>

      <% else %>
        <div class="closed-event-message">
          <h2><%= @nomikai.finished? ? "Matches found" : "Gathering cancelled" %></h2>
          <p>Restaurant swiping is no longer available for this event.</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
