<main class="quick-entry">
  <header class="quick-entry__top">
    <%= link_to join_code_path, class: "quick-entry__back", aria: { label: "Back to join" } do %>
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    <% end %>
    <% if params[:code].present? %>
      <span>JOIN · <%= @nomikai.formatted_join_code %></span>
    <% end %>
  </header>
  <h1>Join the table.</h1>
  <p class="quick-entry__sub">Is this your gathering?</p>
  <section class="quick-entry__card">
    <h2><%= @nomikai.name %></h2>
    <p class="quick-entry__sub">Hosted by <%= @nomikai.user.name %></p>
    <dl class="quick-entry__facts">
      <div><i class="fa-solid fa-location-dot" aria-hidden="true"></i><dt>Location</dt><dd>
        <% if @nomikai.latitude.present? && @nomikai.longitude.present? %>
          <%= link_to (@nomikai.area == "Selected on map" ? "Meeting point" : @nomikai.area), "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode("#{@nomikai.latitude},#{@nomikai.longitude}")}", target: "_blank", rel: "noopener noreferrer" %>
        <% else %><%= @nomikai.area %><% end %>
      </dd></div>
      <div><i class="fa-solid fa-user-group" aria-hidden="true"></i><dt>People</dt><dd><%= @nomikai.group_size %> people</dd></div>
      <div><i class="fa-solid fa-wallet" aria-hidden="true"></i><dt>Budget</dt><dd><%= @nomikai.budget_per_person.present? ? "¥#{number_with_delimiter(@nomikai.budget_per_person)} / person" : "Flexible" %></dd></div>
      <div><i class="fa-solid <%= @nomikai.meal_period == 'lunch' ? 'fa-sun' : 'fa-moon' %>" aria-hidden="true"></i><dt>Meal</dt><dd><%= @nomikai.meal_period.capitalize %></dd></div>
    </dl>
  </section>
  <p class="quick-entry__identity"><i class="fa-regular fa-user" aria-hidden="true"></i> Joining as <%= current_user ? current_user.name : "a guest" %></p>
  <%= button_to "Join & start swiping", @join_path, method: :post, class: "quick-entry__primary" %>
</main>
