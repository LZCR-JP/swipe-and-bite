<% if @selected_candidate.present? %>
  <%= render "legacy_dashboard" %>
<% else %>
  <main class="participant-waiting">
    <header class="participant-waiting__header">
      <%= link_to join_code_path, aria: { label: "Back to Join" } do %><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><% end %>
      <span><%= @nomikai.meal_period.capitalize %> gathering</span>
      <span class="participant-waiting__header-spacer" aria-hidden="true"></span>
    </header>
    <section class="participant-waiting__hero">
      <% if @nomikai.finished? %>
        <span class="participant-waiting__symbol"><i class="fa-solid fa-utensils" aria-hidden="true"></i></span>
        <h1>Matches found.</h1><p>Your host has found restaurant matches. Ask them for the results.</p>
      <% elsif !@nomikai.ongoing? %>
        <span class="participant-waiting__symbol participant-waiting__symbol--muted"><i class="fa-solid fa-xmark" aria-hidden="true"></i></span>
        <h1>Gathering cancelled.</h1><p>Your host cancelled this gathering.</p>
      <% elsif @participant.completed_at.present? %>
        <span class="participant-waiting__symbol"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
        <h1>You're all set.</h1><p>Your swipes are saved. Waiting for your host to find matches.</p>
      <% else %>
        <span class="participant-waiting__symbol"><i class="fa-regular fa-heart" aria-hidden="true"></i></span>
        <h1>Ready to swipe?</h1><p>Pick the food and vibes you love.</p>
      <% end %>
    </section>
    <section class="participant-waiting__summary" aria-label="Gathering details">
      <h2><%= @nomikai.name %></h2>
      <p><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= @nomikai.area == "Selected on map" ? "Pinned location" : @nomikai.area %></p>
      <p><i class="fa-solid fa-user-group" aria-hidden="true"></i> <%= @nomikai.group_size %> people <% if @nomikai.budget_per_person.present? %> · ¥<%= number_with_delimiter(@nomikai.budget_per_person) %> / person <% end %></p>
      <% if @nomikai.ongoing? && @participant.completed_at.present? %>
        <div class="participant-waiting__status"><span class="gathering-status__dot"></span> Waiting for matches</div>
      <% end %>
    </section>
    <% if @nomikai.ongoing? && @participant.completed_at.blank? %>
      <%= link_to "Continue swiping", participant_swipes_path(@participant.token), class: "participant-waiting__primary" %>
    <% elsif @nomikai.ongoing? %>
      <%= link_to "Refresh status", participant_path(@participant.token), class: "participant-waiting__secondary", data: { turbo: false } %>
    <% else %>
      <%= link_to "Back to Join", join_code_path, class: "participant-waiting__primary" %>
    <% end %>
  </main>
<% end %>
