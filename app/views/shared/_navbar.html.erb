<nav class="bottom-nav" aria-label="Main navigation">

  <%= link_to new_nomikai_path,
      class: "bottom-nav__item #{'active' if current_page?(new_nomikai_path)}" do %>
    <i class="fa-solid fa-location-dot"></i>
    <span>Create</span>
  <% end %>

  <%= link_to join_code_path,
      class: "bottom-nav__item #{'active' if controller_name == 'join_codes' || controller_name == 'swipes' || controller_name == 'participants'}" do %>
    <i class="fa-solid fa-users"></i>
    <span>Join</span>
  <% end %>

  <%= link_to nomikais_path,
      class: "bottom-nav__item #{'active' if controller_name == 'nomikais' && action_name != 'new' && action_name != 'create'}" do %>
    <i class="fa-solid fa-calendar-days"></i>
    <span>Gatherings</span>
  <% end %>

  <% account_path = user_signed_in? ? edit_user_registration_path : new_user_session_path %>

  <%= link_to account_path,
      class: "bottom-nav__item #{'active' if devise_controller?}" do %>
    <i class="fa-regular fa-user"></i>
    <span>Account</span>
  <% end %>

</nav>
