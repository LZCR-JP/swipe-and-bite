<div class="container mt-4 swipes-page" data-controller="swipe">
  <% if @current_card.present? %><h1>Find Your Vibe</h1><% end %>

  <% if @show_card_fallback_notice && @current_card.present? %>
    <div class="alert alert-warning" role="status">
      No photo cards match both this event's budget and group size.
      We're showing other photo cards so your team can still share its preferences.
      Some cards may fall outside your event limits.
    </div>
  <% end %>

  <% if @current_card.present? %>
    <p><%= @completed_count %> / <%= @total_cards %> completed</p>

    <div class="progress mb-4">
      <div
        class="progress-bar"
        style="width: <%= @completed_count.to_f / @total_cards * 100 %>%">
      </div>
    </div>

    <div class="swipe-card-stack">
      <div class="swipe-card-shadow swipe-card-shadow--back" aria-hidden="true"></div>
      <div class="swipe-card-shadow swipe-card-shadow--front" aria-hidden="true"></div>

      <article
        class="card p-4 swipe-card"
        data-swipe-target="card"
        data-action="
          pointerdown->swipe#start
          pointermove->swipe#move
          pointerup->swipe#finish
          pointercancel->swipe#cancel">

        <div
          class="swipe-stamp swipe-stamp--like"
          data-swipe-target="likeStamp"
          aria-hidden="true">
          LIKE
        </div>

        <div
          class="swipe-stamp swipe-stamp--nope"
          data-swipe-target="dislikeStamp"
          aria-hidden="true">
          NOPE
        </div>

        <% if @current_card.vibe_card.image_url.present? %>
          <%= image_tag @current_card.vibe_card.image_url,
                        class: "img-fluid rounded mb-3",
                        alt: @current_card.vibe_card.title %>
        <% end %>

        <h2><%= @current_card.vibe_card.title %></h2>
        <p><%= @current_card.vibe_card.description %></p>
      </article>
    </div>

    <div class="d-flex gap-3 swipe-buttons">
      <%= button_to "Dislike",
                    participant_swipes_path(@participant.token),
                    method: :post,
                    params: {
                      nomikai_vibe_card_id: @current_card.id,
                      liked: false
                    },
                    class: "btn btn-danger",
                    data: { swipe_target: "dislikeButton" } %>

      <%= button_to "Like",
                    participant_swipes_path(@participant.token),
                    method: :post,
                    params: {
                      nomikai_vibe_card_id: @current_card.id,
                      liked: true
                    },
                    class: "btn btn-success",
                    data: { swipe_target: "likeButton" } %>
    </div>
  <% else %>
    <section class="quick-entry quick-entry--finish">
      <span class="quick-entry__check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
      <p class="quick-entry__sub">Swipes complete!</p>
      <h2>Any dietary restrictions?</h2>
      <p class="quick-entry__sub">Only select what applies to you. You can finish without selecting anything.</p>
      <%= form_with url: finish_participant_swipes_path(@participant.token), method: :post, scope: :participant do |f| %>
        <fieldset class="quick-entry__choices">
          <legend class="visually-hidden">Dietary restrictions</legend>
          <% Participant::DIETARY_RESTRICTIONS.each_with_index do |restriction, i| %>
            <label class="quick-entry__chip" for="dietary_<%= i %>">
              <%= check_box_tag "participant[restrictions][]", restriction, @participant.restrictions.include?(restriction), id: "dietary_#{i}" %>
              <span><i class="fa-solid fa-check" aria-hidden="true"></i><%= restriction %></span>
            </label>
          <% end %>
          <label class="quick-entry__chip" for="participant_non_drinker">
            <%= f.check_box :non_drinker, checked: @participant.non_drinker? %>
            <span><i class="fa-solid fa-check" aria-hidden="true"></i>No alcohol</span>
          </label>
        </fieldset>
        <%= f.submit "Finish", class: "quick-entry__primary" %>
      <% end %>
    </section>
  <% end %>
</div>
