<div class="container swipes-page" data-controller="swipe">
  <% if @current_card.present? %>
    <% card = @current_card.vibe_card %>
    <% description = card.description.to_s %>
    <% show_description = description.present? && !description.match?(/illustrative .* preference card|provisional, not verified/i) %>
    <% cuisine = card.cuisine.to_s.humanize unless card.cuisine.to_s.casecmp("unspecified").zero? %>
    <% card_type = { "food" => "FOOD IDEA", "people" => "GROUP MOMENT" }.fetch(card.image_type, "RESTAURANT ATMOSPHERE") %>

    <main class="swipe-experience">
      <header class="swipe-page-header">
        <span class="swipe-page-header__eyebrow">YOUR GROUP’S VIBE</span>
        <h1>What are you craving? <span class="sb-emoji" aria-hidden="true">👀</span></h1>
        <p class="swipe-instruction"><i class="fa-solid fa-arrows-left-right" aria-hidden="true"></i> Right to like. Left to pass.</p>
        <%# <p>Swipe through food and restaurant styles. Your preferences help your organizer find real places the group will enjoy.</p> %>
      </header>

      <% if @show_card_fallback_notice %>
        <div class="swipe-fallback-notice" role="status">
          <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
          <span>Some cards may be outside your group’s budget or size range, but your likes still help shape the results.</span>
        </div>
      <% end %>

      <section class="swipe-progress" aria-label="Swiping progress">
        <div class="swipe-progress__label">
          <span>Your preferences</span>
          <strong><%= @completed_count %> of <%= @total_cards %></strong>
        </div>
        <progress class="swipe-progress__bar" value="<%= @completed_count %>" max="<%= @total_cards %>" aria-label="<%= @completed_count %> of <%= @total_cards %> cards completed"><%= @completed_count %> / <%= @total_cards %></progress>
      </section>

      <div class="swipe-card-stack">
        <div class="swipe-card-shadow swipe-card-shadow--back" aria-hidden="true"></div>
        <div class="swipe-card-shadow swipe-card-shadow--front" aria-hidden="true"></div>

        <article
          class="swipe-card"
          data-swipe-target="card"
          data-action="pointerdown->swipe#start pointermove->swipe#move pointerup->swipe#finish pointercancel->swipe#cancel">
          <div class="swipe-stamp swipe-stamp--like" data-swipe-target="likeStamp" aria-hidden="true">LIKE</div>
          <div class="swipe-stamp swipe-stamp--nope" data-swipe-target="dislikeStamp" aria-hidden="true">PASS</div>

          <% if card.image_url.present? %>
            <%= image_tag card.image_url, class: "swipe-card__image", alt: card.title, draggable: false %>
          <% end %>

          <div class="swipe-card__content">
            <div class="swipe-card__tags">
              <span class="swipe-card__type"><span class="sb-emoji" aria-hidden="true"><%= { "food" => "🍽️", "people" => "🥂" }.fetch(card.image_type, "✨") %></span> <%= card_type %></span>
              <% if cuisine.present? %><span class="swipe-card__cuisine"><%= cuisine %></span><% end %>
            </div>
            <h2><%= card.title %></h2>
            <% if show_description %><p><%= description %></p><% end %>
          </div>
        </article>
      </div>

      <%# <p class="swipe-instruction"><i class="fa-solid fa-arrows-left-right" aria-hidden="true"></i> Right to like. Left to pass.</p> %>

      <div class="swipe-buttons">
        <%= button_to participant_swipes_path(@participant.token), method: :post, params: { nomikai_vibe_card_id: @current_card.id, liked: false }, class: "swipe-action swipe-action--pass", data: { swipe_target: "dislikeButton" }, aria: { label: "Pass on #{card.title}" } do %>
          <i class="fa-solid fa-xmark" aria-hidden="true"></i><span>Pass</span>
        <% end %>
        <%= button_to participant_swipes_path(@participant.token), method: :post, params: { nomikai_vibe_card_id: @current_card.id, liked: true }, class: "swipe-action swipe-action--like", data: { swipe_target: "likeButton" }, aria: { label: "Like #{card.title}" } do %>
          <i class="fa-solid fa-heart" aria-hidden="true"></i><span>Like</span>
        <% end %>
      </div>
    </main>
  <% else %>
    <section class="quick-entry quick-entry--finish">
      <span class="quick-entry__check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
      <p class="quick-entry__sub">Swipes complete!</p>
      <h2>Any dietary restrictions? <span class="sb-emoji" aria-hidden="true">🥗</span></h2>
      <p class="quick-entry__sub">Select any that apply, or skip straight to the finish.</p>
      <%= form_with url: finish_participant_swipes_path(@participant.token), method: :post, scope: :participant do |f| %>
        <fieldset class="quick-entry__choices">
          <legend class="visually-hidden">Dietary restrictions</legend>
          <% Participant::DIETARY_RESTRICTIONS.each_with_index do |restriction, i| %>
            <label class="quick-entry__chip" for="dietary_<%= i %>">
              <%= check_box_tag "participant[restrictions][]", restriction, @participant.restrictions.include?(restriction), id: "dietary_#{i}" %>
              <span><i class="fa-solid fa-check" aria-hidden="true"></i><%= restriction %></span>
            </label>
          <% end %>
          <label class="quick-entry__chip" for="participant_non_drinker">
            <%= f.check_box :non_drinker, checked: @participant.non_drinker? %>
            <span><i class="fa-solid fa-check" aria-hidden="true"></i>No alcohol</span>
          </label>
        </fieldset>
        <%= f.submit "Finish", class: "quick-entry__primary" %>
      <% end %>
    </section>
  <% end %>
</div>
